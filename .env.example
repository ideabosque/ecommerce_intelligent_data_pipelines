# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-products-bucket
S3_PREFIX=products/incoming/
S3_PROCESSED_PREFIX=products/processed/
S3_DEAD_LETTER_PREFIX=products/dead_letter/

# WooCommerce Configuration
WOOCOMMERCE_URL=https://your-store.com/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
WOOCOMMERCE_TIMEOUT=30
WOOCOMMERCE_REQUESTS_PER_SECOND=10

# Knowledge Graph Configuration
KNOWLEDGE_GRAPH_URL=http://localhost:8000
KNOWLEDGE_GRAPH_ENDPOINT_ID=your_endpoint_id
KNOWLEDGE_GRAPH_PART_ID=your_part_id
KNOWLEDGE_GRAPH_API_KEY=your_api_key
KNOWLEDGE_GRAPH_BEARER_TOKEN=

# RFQ Engine Configuration
RFQ_ENGINE_BASE_URL=http://localhost:8000
RFQ_ENGINE_ENDPOINT_ID=gpt
RFQ_ENGINE_PART_ID=your_part_id
RFQ_ENGINE_API_KEY=your_api_key
RFQ_ENGINE_BEARER_TOKEN=
RFQ_ENGINE_UPDATED_BY=dagster-pipeline
RFQ_ENGINE_TIMEOUT=60
RFQ_ENGINE_REQUESTS_PER_SECOND=5
RFQ_ENGINE_PROVIDER_EXTERNAL_ID=woocommerce
RFQ_ENGINE_DEFAULT_UOM=EA
RFQ_ENGINE_ENABLE_PRICE_TIERS=false

# Pipeline Configuration
MAX_RETRIES=3
BATCH_SIZE=25

# Logging
LOG_LEVEL=INFO